# Postgres (Neon). DATABASE_URL = pooled connection, DIRECT_URL = direct connection (used by migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/retain?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/retain?sslmode=verify-full"

# Auth
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# HTTP
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Seed (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-admin-password"
SEED_USER_PASSWORD="change-me-user-password"
